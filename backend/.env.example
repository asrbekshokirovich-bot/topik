PORT=4000
# Either provide a full connection string...
DATABASE_URL=postgres://postgres:postgres@localhost:5432/topik_station
# ...or discrete variables (used only when DATABASE_URL is unset):
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_NAME=topik_station
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
# Set to true to require SSL on the Postgres connection.
PGSSL=false
# Anthropic API key for the AI features (tutor, writing correction, quiz,
# grading assistant). Get one at https://console.anthropic.com. Leave empty to
# disable AI features (the rest of the app works without it).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
